// Bluetooth MAC of ur original GO Plus, in normal reading order.
// First byte must be even (e.g. 98:B6:E9:xx:xx:xx).
#define PGP_MAC_HEX "98B6E9112233"

// 16-byte device key (32 hex characters)
#define PGP_DEVICE_KEY_HEX "000102030405060708090A0B0C0D0E0F"

// 256-byte blob (512 hex characters)
#define PGP_BLOB_HEX ""

#define PGP_HOTSPOT_SSID "UR HOTSPOT NAME" // ur hotspot name so the esp32 can connect and host the admin panel
#define PGP_HOTSPOT_PASSWORD "UR HOTSPOT PASSWORD" // ur hotspot password so the esp32 can connect
 
#define PGP_DEVICE_LABEL "Sarahs Pogo Plus" // friendly name for device label in the admin panel